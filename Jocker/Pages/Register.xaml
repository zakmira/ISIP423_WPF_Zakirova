<Page x:Class="Jocker.Pages.Register"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Jocker.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="PaleGreen"
      Title="Register">

    <Grid Margin="20" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Регистрация" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,30"/>

        <TextBox x:Name="Name" ToolTip="Введите имя" 
                 Grid.Row="1" Margin="0,10,0,10" 
                 Width="250" Height="30" 
                 HorizontalAlignment="Center"/>

        <TextBox x:Name="Email" ToolTip="Введите почту" 
                 Grid.Row="2" Margin="0,10,0,10"
                 Width="250" Height="30" 
                 HorizontalAlignment="Center"/>

        <TextBox x:Name="Login" ToolTip="Введите логин"
                 Grid.Row="3" Margin="0,10,0,10" 
                 Width="250" Height="30" 
                 HorizontalAlignment="Center"/>

        <PasswordBox x:Name="Password" ToolTip="Придумайте пароль" 
                     Grid.Row="4" Margin="0,10,0,10" 
                     Width="250" Height="30" 
                     HorizontalAlignment="Center"/>

        <Button x:Name="btnSignIn" Grid.Row="5" 
                Content="Зарегистрироваться" Background="Orchid" 
                Click="SignIn_Click" 
                Width="200" HorizontalAlignment="Center" 
                Padding="8" Margin="0,10,0,20"/>

        <TextBlock Grid.Row="6" HorizontalAlignment="Center" 
                   Margin="0,0,0,20" Height="16" VerticalAlignment="Top">
                   <Hyperlink Click="SignInLink_Click" Foreground="Black">
                       Уже есть аккаунт? Войти
                   </Hyperlink>
        </TextBlock>
    </Grid>
</Page>