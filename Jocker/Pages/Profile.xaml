<Page x:Class="Jocker.Pages.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Jocker.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="PaleGreen"
      Title="Profile">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Мой профиль" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Border x:Name="FreezeWarningB" Grid.Row="1" 
                CornerRadius="5"  Padding="10"
                Margin="0,0,0,15" Visibility="Collapsed">
                
            <StackPanel>
                <TextBlock x:Name="FreezeWarning" 
                           Text="" FontWeight="Bold" TextWrapping="Wrap"/>
                <Button x:Name="btnAppealFreeze" Content="Оспорить" 
                        Background="Orchid" Padding="10,5" Margin="0,5,0,0" 
                        Width="80" HorizontalAlignment="Left"
                        Click="AppealFreeze_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#F5F5F5" CornerRadius="8" 
                Padding="15" Margin="0,0,0,15" Width="700">
            <StackPanel>
                <TextBlock Text="Информация о пользователе" 
                           FontSize="16" FontWeight="Bold" 
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="Имя:" FontWeight="SemiBold" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="Name" Grid.Row="0" 
                               Grid.Column="1" Text="" 
                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <Button x:Name="EditName" Grid.Row="0" Grid.Column="2" 
                            Content="Изменить" Width="70" Height="30" 
                            Margin="10,0,0,0" Background="Orchid" 
                            BorderThickness="0" Click="EditName_Click"/>

                    <TextBlock Grid.Row="0" Grid.Column="3" 
                               Text="Логин:" FontWeight="SemiBold" 
                               VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <TextBlock x:Name="Login" Grid.Row="0" Grid.Column="4" 
                               Text="" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <Button x:Name="EditLogin" Grid.Row="0" Grid.Column="5" 
                            Content="Изменить" Width="70" Height="30" 
                            Margin="10,0,0,0" Background="Orchid" 
                            BorderThickness="0" Click="EditLogin_Click"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="Email:" FontWeight="SemiBold" 
                               VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock x:Name="Email" Grid.Row="1" Grid.Column="1" 
                               Text="" VerticalAlignment="Center" Margin="5,10,0,0"/>
                    <Button x:Name="EditEmail" Grid.Row="1" Grid.Column="2" 
                            Content="Изменить" Width="70" Height="30" 
                            Margin="10,10,0,0" Background="Orchid" 
                            BorderThickness="0" Click="EditEmail_Click"/>

                    <TextBlock Grid.Row="1" Grid.Column="3" 
                               Text="Пароль:" FontWeight="SemiBold" 
                               VerticalAlignment="Center" Margin="20,10,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" 
                               Text="●●●●●●" VerticalAlignment="Center" Margin="5,10,0,0"/>
                    <Button x:Name="EditPassword" Grid.Row="1" Grid.Column="5" 
                            Content="Изменить" Width="70" Height="30" 
                            Margin="10,10,0,0" Background="Orchid" 
                            BorderThickness="0" Click="EditPassword_Click"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" 
                               Text="Роль:" FontWeight="SemiBold" 
                               VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock x:Name="Role" Grid.Row="2" Grid.Column="1" 
                               Text="" VerticalAlignment="Center" Margin="5,10,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <Button x:Name="SubmitAuthorRequestB" Grid.Row="3" 
                Content="Подать заявку на роль автора" 
                Background="Orchid" Padding="15,8" 
                Width="200" HorizontalAlignment="Left"
                Click="SubmitAuthorRequest_Click"/>

        <Border Grid.Row="4" Background="#F5F5F5" CornerRadius="8" 
                Padding="15" Margin="0,15,0,0">
            <StackPanel>
                <TextBlock Text="Мои отзывы" 
                           FontSize="16" FontWeight="Bold" 
                           Margin="0,0,0,10"/>

                <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ReviewsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" 
                                        Padding="10" Margin="0,5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding BookTitle}" 
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Rating, StringFormat='⭐ {0}'}" 
                                                   FontSize="11" Foreground="Orchid"/>
                                        <TextBlock Text="{Binding Comment}" 
                                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
           