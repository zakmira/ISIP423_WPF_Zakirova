<Page x:Class="Jocker.Pages.Admin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Jocker.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="PaleGreen"
      Title="Admin">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Панель администратора" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,0,0,15">
            <RadioButton x:Name="rbAppeals" Content="Жалобы" 
                         GroupName="AdminSections" Margin="0,0,0,0"
                         Checked="Section_Checked" 
                         Background="Orchid" Padding="12,8" IsChecked="True"/>
            <RadioButton x:Name="rbUnfreeze" Content="Заявки на разморозку" 
                         GroupName="AdminSections" 
                         Checked="Section_Checked" 
                         Background="Orchid" Padding="12,8"/>
            <RadioButton x:Name="rbAuthorRequests" Content="Заявки на роль автора" 
                         GroupName="AdminSections" 
                         Checked="Section_Checked" 
                         Background="Orchid" Padding="12,8"/>
            <RadioButton x:Name="rbFrozen" Content="Замороженные" 
                         GroupName="AdminSections" 
                         Checked="Section_Checked" 
                         Background="Orchid" Padding="12,8"/>
            <RadioButton x:Name="rbUsers" Content="Пользователи" 
                         GroupName="AdminSections" 
                         Checked="Section_Checked" 
                         Background="Orchid" Padding="12,8"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" 
                                Padding="10" Margin="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DisplayText}" 
                                           FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SubText}" 
                                           FontSize="11"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="Accept" Content="Принять" 
                                            Background="Orchid"
                                            Padding="10,5" Margin="0,0,5,0"
                                            Click="Accept_Click" Tag="{Binding Id}"
                                            Visibility="{Binding ShowAccept, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button x:Name="Reject" Content="Отклонить" 
                                            Background="Orchid"
                                            Padding="10,5" Margin="0,0,5,0"
                                            Click="Reject_Click" Tag="{Binding Id}"
                                            Visibility="{Binding ShowReject, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button x:Name="AssignRole" Content="Назначить роль" 
                                            Background="Orchid"
                                            Padding="10,5" Margin="0,0,5,0"
                                            Click="AssignRole_Click" Tag="{Binding Id}"
                                            Visibility="{Binding ShowAssignRole, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button x:Name="FreezeUser" Content="Заморозить" 
                                            Background="Orchid" Padding="10,5" 
                                            Margin="0,0,5,0" Click="FreezeUser_Click"
                                            Tag="{Binding Id}" Visibility="{Binding ShowFreezeUser, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button x:Name="UnfreezeUser" Content="Разморозить" 
                                            Background="Orchid" Padding="10,5" Margin="0,0,5,0"
                                            Click="UnfreezeUser_Click" Tag="{Binding Id}"
                                            Visibility="{Binding ShowUnfreezeUser, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button x:Name="ChangePassword" Content="Сменить пароль" 
                                            Background="Orchid" Padding="10,5"
                                            Click="ChangePassword_Click" Tag="{Binding Id}"
                                            Visibility="{Binding ShowChangePassword, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
           