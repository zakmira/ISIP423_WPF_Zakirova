<Page x:Class="Jocker.Pages.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Jocker.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="PaleGreen"
      Title="BookPage">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="150" Height="200" 
                    Background="LightGray" CornerRadius="8"
                    Margin="0,0,20,0">
                <Image x:Name="CoverImage" Width="150" Height="200" 
                       Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="Title" FontSize="24" FontWeight="Bold" 
                           TextWrapping="Wrap" Margin="0,0,0,5"/>
                <TextBlock x:Name="Author" FontSize="14" 
                           Margin="0,0,0,5"/>
                <TextBlock x:Name="Rating" FontSize="14" 
                           Margin="0,0,0,5"/>
                <TextBlock x:Name="Genres" FontSize="14" 
                           Margin="0,0,0,5"/>
                <TextBlock x:Name="Description" FontSize="13" 
                           TextWrapping="Wrap" MaxHeight="80"
                           TextTrimming="WordEllipsis" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnComplainBook" Content="Жалоба на книгу" 
                            Click="ComplainBook_Click" Margin="0,0,10,0" 
                            Background="Orchid" Padding="8"/>
                    <Button x:Name="ComplainAuthorBtn" Content="Жалоба на автора" 
                            Click="ComplainAuthor_Click" Margin="0,0,10,0" 
                            Background="Orchid" Padding="8"/>
                    <Button x:Name="btnFreezeBook" Content="Заморозить книгу" 
                            Click="FreezeBook_Click" 
                            Background="Orchid" Padding="8"
                            Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Expander Header="Отзывы" IsExpanded="True">
                    <StackPanel>
                        <Border Background="#F0F0F0" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Оценка:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <ComboBox x:Name="RatingCombo" Width="60" SelectedIndex="0">
                                        <ComboBoxItem Content="5"/>
                                        <ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="3"/>
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="1"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBox x:Name="ReviewComment" Height="60" 
                                         TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <Button x:Name="btnAddReview" Content="Добавить отзыв" Background="Orchid"
                                        Click="AddReview_Click" Width="120" Padding="5"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="ReviewsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" 
                                            Padding="10" Margin="0,5">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding UserName}" FontWeight="Bold" 
                                                           Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Rating, StringFormat='⭐ {0}'}"/>
                                                <Button Content="Жалоба" 
                                                        Click="ComplainReview_Click"
                                                        Tag="{Binding ReviewID}"
                                                        Background="Transparent" 
                                                        BorderThickness="0"
                                                        Margin="20,0,0,0"
                                                        Cursor="Hand"/>
                                                <Button x:Name="FreezeReview" 
                                                        Content="Заморозить" 
                                                        Click="FreezeReview_Click"
                                                        Tag="{Binding ReviewID}"
                                                        Foreground="White"
                                                        Margin="10,0,0,0"
                                                        Padding="5"
                                                        Visibility="Collapsed"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ReviewText}" 
                                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>