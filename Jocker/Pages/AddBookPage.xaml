<Page x:Class="Jocker.Pages.AddBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Jocker.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="PaleGreen"
      Title="AddBook">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Добавление новой книги" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Название" 
                   Margin="0,0,0,5" FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>
        <TextBox x:Name="Title" Grid.Row="2" 
                 Height="30" Width="150" 
                 Margin="0,0,0,10" Padding="5"/>

        <TextBlock Grid.Row="3" Text="Описание" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5" FontWeight="SemiBold"/>
        <TextBox x:Name="Description" Grid.Row="4" 
                 Height="60" Width="250" TextWrapping="Wrap" 
                 Margin="0,0,0,10" Padding="5" AcceptsReturn="True"/>

        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="Жанры" HorizontalAlignment="Center"
                       FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ListBox x:Name="lstGenres" Height="70" Width="150"
                     SelectionMode="Multiple"
                     BorderBrush="#DDDDDD" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding GenreName}" 
                              Tag="{Binding GenreID}"
                              Checked="Genre_Checked"
                              Unchecked="Genre_Unchecked"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="Save" Content="Сохранить" 
                    Click="Save_Click"
                    Background="Orchid" Padding="20,10" 
                    Margin="0,0,10,0" Width="120"/>
            <Button x:Name="Cancel" Content="Отмена" 
                    Click="Cancel_Click"
                    Background="Orchid" Padding="20,10" 
                    Width="120"/>
        </StackPanel>
    </Grid>
</Page>

            