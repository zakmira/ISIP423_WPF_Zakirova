<Page x:Class="WpfApp17.Pages.Manager.ProductTypeEdit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp17.Pages.Manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Gainsboro"
      Title="ProductTypeEdit">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="Back" Content="Назад" Width="80" Height="30" 
                HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Редактирование типа товара" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Grid Grid.Row="2" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Название:" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="Name" Height="30" Width="150" HorizontalAlignment="Left" Padding="5"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="Save" Content="Сохранить" Width="100" Height="35" 
                    Margin="0,0,15,0" Background="LightGreen" Click="Save_Click"/>
            <Button x:Name="Cancel" Content="Отмена" Width="100" Height="35" 
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Page>
