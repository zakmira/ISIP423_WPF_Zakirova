<Page x:Class="WpfApp17.Pages.Manager.ProductEdit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp17.Pages.Manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Gainsboro"
      Title="ProductEdit">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="Back" Content="Назад" Width="80" Height="30" 
                HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Редактирование товара" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Grid Grid.Row="2" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Название:" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="Name" Height="30" Width="150" HorizontalAlignment="Left" Padding="5"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Стоимость (руб.):" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="Price" Height="30" Width="150" HorizontalAlignment="Left" Padding="5"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Описание:" FontWeight="Bold" FontSize="13" VerticalAlignment="Top"/>
            <TextBox Grid.Column="1" x:Name="Description" Height="40" Width="150" HorizontalAlignment="Left" TextWrapping="Wrap" 
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Скидка (%):" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="Discount" Height="30" Width="150" HorizontalAlignment="Left" Padding="5" Text="0"/>
        </Grid>

        <Grid Grid.Row="6" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Производитель:" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="Manufacturer" Height="30" Width="150" HorizontalAlignment="Left" DisplayMemberPath="Name"/>
        </Grid>

        <Grid Grid.Row="7" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Тип товара:" FontWeight="Bold" FontSize="13" VerticalAlignment="Top"/>
            <ComboBox Grid.Column="1" x:Name="ProductType" Height="30" Width="150" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-7" DisplayMemberPath="Name"/>
        </Grid>

        <StackPanel Grid.Row="8" Orientation="Vertical"  HorizontalAlignment="Center" Margin="0,-65,0,0">
            <Button x:Name="Save" Content="Сохранить" Width="100" Height="35" Margin="15"
                    Background="LightGreen" Click="Save_Click"/>
            <Button x:Name="Cancel" Content="Отмена" Width="100" Height="35" 
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Page>