<Window x:Class="WpfApp17.Pages.Manager.ManufacturerEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp17.Pages.Manager"
        mc:Ignorable="d"
        Title="ManufacturerEdit" Height="450" Width="800" Background="Gainsboro">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="Back" Grid.Row="0" Content="Назад" Width="80" Height="30" 
                HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,15" VerticalAlignment="Bottom"/>

        <TextBlock Grid.Row="1" Text="Редактирование производителя" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Grid Grid.Row="2" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Название:" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="Name" Height="30" Padding="5" Width="100" HorizontalAlignment="Left"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Страна:" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="Country" Height="30" Padding="5" Width="100" HorizontalAlignment="Left"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-80,0,0">
            <Button x:Name="Save" Content="Сохранить" Width="100" Height="35" Click="Save_Click" Background="LightGreen" Margin="0,0,15,0"/>
            <Button x:Name="Cancel" Content="Отмена" Width="100" Height="35" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
