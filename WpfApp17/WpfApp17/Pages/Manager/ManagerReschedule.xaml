<Page x:Class="WpfApp17.Pages.Manager.ManagerReschedule"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp17.Pages.Manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Gainsboro"
      Title="ManagerReschedule">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Button x:Name="Back" Content="Назад" Width="80" Height="30" 
                HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Перенос записи" FontSize="22" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,5,0,20"/>

        <TextBlock Grid.Row="2" x:Name="AppointmentInfo" FontSize="13" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,0" VerticalAlignment="Center"/>

        <Grid Grid.Row="3" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Новая дата и время:" FontWeight="Bold" VerticalAlignment="Center"/>
            <DatePicker Grid.Column="1" x:Name="NewDate" Width="200" HorizontalAlignment="Left"/>
            <ComboBox Grid.Column="2" x:Name="NewTime" Width="80" Height="30" Margin="20,0,10,0" HorizontalAlignment="Left" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10">
            <Button x:Name="Save" Content="Перенести" Width="100" Height="35" 
                    Margin="0,0,15,0" Background="LightGreen" Click="Save_Click"/>
            <Button x:Name="Cancel" Content="Отмена" Width="100" Height="35" 
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Page>