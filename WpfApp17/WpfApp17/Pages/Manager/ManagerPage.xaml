<Page x:Class="WpfApp17.Pages.Manager.ManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Gainsboro"
      Title="Manager">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="Back" Content="Назад" Width="80" Height="30" 
                HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Панель управления" FontSize="22" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,5,0,15"/>

        <TabControl Grid.Row="2" Margin="0,5">

            <TabItem Header="Записи" Height="22" Margin="-2,-2,-2,0" VerticalAlignment="Top">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button x:Name="CreateAppointment" Content="Новая запись" Width="100" Height="30" 
                                Click="CreateAppointment_Click" Background="LightGreen" Margin="0,0,10,0"/>
                    </WrapPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Поиск клиента:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <WrapPanel>
                            <TextBox x:Name="ClientSearch" Width="250" Height="30" Margin="0,0,10,0" 
                                     TextChanged="ClientSearch_TextChanged"/>
                            <Button x:Name="ClearSearch" Content="Очистить" Width="80" Height="30" 
                                    Click="ClearSearch_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AppointmentsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" 
                                            Margin="0,5,0,5" Padding="10" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ServiceName}" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="{Binding FullName}" FontSize="12" Foreground="Gray"/>
                                                <TextBlock Text="{Binding AppointmentDateTime, StringFormat='Дата: dd.MM.yyyy HH:mm'}" FontSize="12"/>
                                                <TextBlock Text="{Binding MasterName}" FontSize="11" Foreground="Gray"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="Перенести" Width="80" Height="30" 
                                                    Click="Reschedule_Click" Tag="{Binding}" Margin="5,0"/>

                                            <Button Grid.Column="3" Content="Отменить" Width="80" Height="30" 
                                                    Click="CancelAppointment_Click" Tag="{Binding}" Background="LightCoral" Margin="5,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Заказы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="OrdersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" 
                                            Margin="0,5,0,5" Padding="10" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontWeight="Bold" FontSize="14">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="Заказ №{0} от {1:dd.MM.yyyy}">
                                                            <Binding Path="Id"/>
                                                            <Binding Path="OrderDate"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FullName}" FontSize="12" Foreground="Gray"/>
                                                <TextBlock Text="{Binding TotalAmount, StringFormat='Сумма: {0:F2} ₽'}" FontSize="12"/>
                                                <TextBlock Text="{Binding DesiredPickupDate, StringFormat='Дата получения: {0:dd.MM.yyyy}'}" FontSize="11" Foreground="Gray"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" FontWeight="Bold" 
                                                       VerticalAlignment="Center" Margin="15,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="New">
                                                                <Setter Property="Foreground" Value="Blue"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Foreground" Value="Green"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                <Setter Property="Foreground" Value="Red"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Grid.Column="2" Content="Выдать заказ" Width="100" Height="30" 
                                                    Click="CompleteOrder_Click" Tag="{Binding}" 
                                                    Background="LightGreen" Margin="5,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Товары">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="179*"/>
                        <ColumnDefinition Width="22*"/>
                        <ColumnDefinition Width="553*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,10" Grid.ColumnSpan="3">
                        <Button x:Name="AddProduct" Content="Добавить товар" Width="130" Height="30" 
                                Click="AddProduct_Click" Background="LightGreen" Margin="0,0,10,0"/>
                    </WrapPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="3">
                        <ItemsControl x:Name="ProductsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" 
                                            Margin="0,5,0,5" Padding="10" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0:F2} ₽'}" FontSize="12"/>
                                                <TextBlock Text="{Binding DiscountPercent, StringFormat='Скидка: {0}%'}" FontSize="11" Foreground="Red"/>
                                                <TextBlock Text="{Binding Manufacturer.Name}" FontSize="11" Foreground="Gray"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="Скидка:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBox x:Name="DiscountBox" Width="50" Height="25" Text="{Binding DiscountPercent}"
                                                         LostFocus="Discount_LostFocus" Tag="{Binding}"/>
                                                <TextBlock Text="%" VerticalAlignment="Center" Margin="5,0,10,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="Заморозить" Width="90" Height="30" 
                                                    Click="FreezeProduct_Click" Tag="{Binding}" Margin="5,0"
                                                    Background="Orange">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                                <Setter Property="Content" Value="Разморозить"/>
                                                                <Setter Property="Background" Value="LightGreen"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Grid.Column="3" Content="Удалить" Width="80" Height="30" 
                                                    Click="DeleteProduct_Click" Tag="{Binding}" 
                                                    Background="LightCoral" Margin="5,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Типы товаров">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="275*"/>
                        <ColumnDefinition Width="479*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,10" Grid.ColumnSpan="2">
                        <Button x:Name="AddProductType" Content="Добавить тип" Width="130" Height="30" 
                                Click="AddProductType_Click" Background="LightGreen" Margin="0,0,10,0"/>
                    </WrapPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2">
                        <ItemsControl x:Name="ProductTypesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" 
                                        Margin="0,5,0,5" Padding="10" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>

                                            <Button Grid.Column="1" Content="Изменить" Width="80" Height="30" 
                                                    Click="EditProductType_Click" Tag="{Binding}" Margin="5,0"/>

                                            <Button Grid.Column="2" Content="Удалить" Width="80" Height="30" 
                                                    Click="DeleteProductType_Click" Tag="{Binding}" 
                                                    Background="LightCoral" Margin="5,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Производители">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button x:Name="AddManufacturer" Content="Добавить производителя" Width="180" Height="30" 
                                Click="AddManufacturer_Click" Background="LightGreen" Margin="0,0,10,0"/>
                    </WrapPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ManufacturersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" 
                                            Margin="0,5,0,5" Padding="10" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="{Binding Country}" FontSize="12" Foreground="Gray"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="Изменить" Width="80" Height="30" 
                                                    Click="EditManufacturer_Click" Tag="{Binding}" Margin="5,0"/>

                                            <Button Grid.Column="2" Content="Удалить" Width="80" Height="30" 
                                                    Click="DeleteManufacturer_Click" Tag="{Binding}" 
                                                    Background="LightCoral" Margin="5,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Типы услуг">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button x:Name="AddServiceType" Content="Добавить тип" Width="130" Height="30" 
                                Click="AddServiceType_Click" Background="LightGreen" Margin="0,0,10,0"/>
                    </WrapPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ServiceTypesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" 
                                            Margin="0,5,0,5" Padding="10" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>

                                            <Button Grid.Column="1" Content="Изменить" Width="80" Height="30" 
                                                    Click="EditServiceType_Click" Tag="{Binding}" Margin="5,0"/>

                                            <Button Grid.Column="2" Content="Удалить" Width="80" Height="30" 
                                                    Click="DeleteServiceType_Click" Tag="{Binding}" 
                                                    Background="LightCoral" Margin="5,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
            