<Page x:Class="WpfApp17.Pages.Master.AppointmentDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Gainsboro"
      Title="AppointmentDetails">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="Back" Content="Назад" Width="80" Height="30" 
                HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Детали записи" FontSize="22" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,5,0,10"/>

        <Grid Grid.Row="2" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Услуга:" FontWeight="Bold" FontSize="13"/>
            <TextBlock Grid.Column="1" x:Name="Service" FontSize="13" TextWrapping="Wrap"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Дата и время:" FontWeight="Bold" FontSize="13"/>
            <TextBlock Grid.Column="1" x:Name="DateTime" FontSize="13"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Клиент:" FontWeight="Bold" FontSize="13"/>
            <TextBlock Grid.Column="1" x:Name="Client" FontSize="13"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Телефон:" FontWeight="Bold" FontSize="13"/>
            <TextBlock Grid.Column="1" x:Name="Phone" FontSize="13"/>
        </Grid>

        <Grid Grid.Row="6" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Комментарий:" FontWeight="Bold" FontSize="13" VerticalAlignment="Top"/>
            <TextBlock Grid.Column="1" x:Name="Comment" FontSize="12" TextWrapping="Wrap"/>
        </Grid>

        <Button x:Name="Complete" Grid.Row="7" Content="Завершить запись" 
                Width="150" Height="40" HorizontalAlignment="Center" 
                Margin="0,10,0,0" Background="LightGreen" FontSize="13"
                Click="Complete_Click" VerticalAlignment="Top"/>
    </Grid>
</Page>
            