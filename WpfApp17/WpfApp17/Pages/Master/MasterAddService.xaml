<Page x:Class="WpfApp17.Pages.Master.MasterAddService"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Gainsboro"
      Title="MasterAddService">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button x:Name="Back" Content="Назад" Width="80" Height="30" 
                HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Добавление услуги" FontSize="22" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,5,0,25"/>

        <Grid Grid.Row="2" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Название услуги:" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="ServiceName" Height="30" Width="100" Padding="5" HorizontalAlignment="Left"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Стоимость (руб.):" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="Price" Height="30" Width="100" Padding="5" HorizontalAlignment="Left"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Длительность (мин):" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="Duration" Height="30" Width="100" Padding="5" Text="60" HorizontalAlignment="Left"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Тип услуги:" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="ServiceType" Height="30" Width="100" DisplayMemberPath="Name" HorizontalAlignment="Left"/>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="Save" Content="Сохранить" Width="100" Height="30" 
                    Margin="0,0,15,0" Background="LightGreen" Click="Save_Click"/>
            <Button x:Name="Cancel" Content="Отмена" Width="100" Height="30" 
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Page> 
           