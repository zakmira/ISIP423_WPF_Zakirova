<Page x:Class="WpfApp17.Pages.Admin.Admin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Gainsboro"
      Title="Admin">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="Back" Content="Назад" Width="80" Height="30" 
                HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Управление пользователями" FontSize="22" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,5,0,15"/>

        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <Button x:Name="AddUser" Content="Добавить пользователя" Width="150" Height="35" 
                    Click="AddUser_Click" Background="LightGreen" Margin="0,0,10,0"/>
        </WrapPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="UsersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" 
                                Margin="0,5,0,5" Padding="10" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Login}" FontSize="11" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="Gray"/>
                                    <TextBlock Text="{Binding RegistrationDate, StringFormat='Регистрация: dd.MM.yyyy'}" FontSize="10" Foreground="Gray"/>
                                </StackPanel>

                                <Button Grid.Column="2" Width="100" Height="30" VerticalAlignment="Center" Margin="5,0"
                                        Click="ToggleFreeze_Click" Tag="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="Заморозить"/>
                                            <Setter Property="Background" Value="Orange"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                    <Setter Property="Content" Value="Разморозить"/>
                                                    <Setter Property="Background" Value="LightGreen"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="3" Content="Изменить" Width="80" Height="30" 
                                        Click="EditUser_Click" Tag="{Binding}" Margin="5,0"/>

                                <Button Grid.Column="4" Content="Удалить" Width="80" Height="30" 
                                        Click="DeleteUser_Click" Tag="{Binding}" Background="LightCoral" Margin="5,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Background" Value="LightGray"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>