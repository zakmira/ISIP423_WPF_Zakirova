<Page x:Class="WpfApp17.Pages.Client.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Gainsboro"
      Title="ProductsPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="Back" Grid.Row="0" Content="Назад" Width="80" Height="30" 
                HorizontalAlignment="Left" Margin="0,0,0,10" Click="Back_Click"/>

        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBox x:Name="Search" Grid.Row="1" Height="25" Margin="0,5" 
                     TextChanged="Search_TextChanged"
                     GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"/>

            <WrapPanel Grid.Row="2" Margin="0,5">
            <ComboBox x:Name="ProductTypeFilter" Width="150" Height="25" Margin="0,0,5,5"
                      DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/>

            <ComboBox x:Name="ManufacturerFilter" Width="150" Height="25" Margin="0,0,5,5"
                      DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/>

            <ComboBox x:Name="Sort" Width="150" Height="25" Margin="0,0,5,5"
                      SelectionChanged="Sort_Changed">
                <ComboBoxItem Content="По умолчанию" IsSelected="True"/>
                <ComboBoxItem Content="По оценке (сначала высокие)"/>
                <ComboBoxItem Content="По оценке (сначала низкие)"/>
            </ComboBox>

            <Button x:Name="Cart" Content="Корзина" Width="100" Height="25"
                    Click="Cart_Click" Margin="0,0,0,5"/>
        </WrapPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ListBox x:Name="ProductList" Grid.Row="3" Background="Transparent" BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" 
                                Padding="5" Width="220"
                                Background="White">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DiscountPercent}" Value="0">
                                            <Setter Property="Background" Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DiscountPercent}" Value="15">
                                            <Setter Property="Background" Value="LightYellow"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DiscountPercent}" Value="20">
                                            <Setter Property="Background" Value="LightYellow"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DiscountPercent}" Value="30">
                                            <Setter Property="Background" Value="LightYellow"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DiscountPercent}" Value="50">
                                            <Setter Property="Background" Value="LightYellow"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" 
                                           TextWrapping="Wrap" Margin="0,0,0,5"/>

                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0} ₽'}" 
                                           FontSize="12" Margin="0,0,0,3"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Скидка: " FontSize="11"/>
                                    <TextBlock Text="{Binding DiscountPercent}" FontSize="11" 
                                               Foreground="Red" FontWeight="Bold"/>
                                    <TextBlock Text="%" FontSize="11" Foreground="Red"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Manufacturer.Name}" FontSize="10" 
                                           Foreground="Gray" Margin="0,0,0,5"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding Rating, StringFormat='Рейтинг: {0:F1}/5'}"
                                               FontSize="11" Margin="0,0,0,5"/>
                                </StackPanel>

                                <Button Content="Подробнее" Height="25" Margin="0,0,0,5"
                                        Click="Details_Click" Tag="{Binding}"/>

                                <Button x:Name="AddToCart" Content="В корзину" Height="25" 
                                        Click="AddToCart_Click" Tag="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="LightGreen"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                    <Setter Property="Background" Value="LightGray"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Content" Value="Заморожен"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </StackPanel>
    </Grid>
</Page>