<Page x:Class="WpfApp17.Pages.Client.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Gainsboro"
      Title="OrderPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button x:Name="Back" Content="Назад" Width="80" Height="30" 
                HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="1" Text="Оформление заказа" FontSize="22" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,5,0,15"/>

        <Grid Grid.Row="2" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="LightGray" BorderThickness="1" 
                    CornerRadius="8" Padding="10" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="Ваш заказ" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <ListBox x:Name="OrderList" Height="100" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Margin="0,2">
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Quantity}" Width="15"/>
                                        <TextBlock Grid.Column="1" Text="x" Width="10" Margin="10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ProductName}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalPrice, StringFormat=' {0:F2} ₽'}" 
                                                   Margin="0,0,-55,0" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Separator Margin="0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Итого:" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" x:Name="TotalAmount" FontSize="16" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                <Border Background="White" BorderBrush="LightGray" BorderThickness="1" 
                        CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Дата получения" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <TextBlock Text="(не более 7 дней)" FontSize="10" Foreground="Gray" Margin="0,-8,0,8"/>
                        <DatePicker x:Name="PickupDate" Width="180" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="LightGray" BorderThickness="1" 
                        CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Способ оплаты" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <ComboBox x:Name="PaymentMethod" Width="180" HorizontalAlignment="Left"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                    <Button x:Name="Confirm" Content="Подтвердить заказ" Width="150" Height="38" 
                            Background="LightGreen" FontSize="13" Click="Confirm_Click" Margin="0,0,10,0"/>
                    <Button x:Name="Cancel" Content="Отмена" Width="100" Height="38" 
                            FontSize="13" Click="Cancel_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
                    
                    

           
            