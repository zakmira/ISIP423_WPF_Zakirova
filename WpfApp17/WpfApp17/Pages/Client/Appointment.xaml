<Page x:Class="WpfApp17.Pages.Client.Appointment"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
          xmlns:local="clr-namespace:WpfApp17.Pages"
          mc:Ignorable="d" 
          d:DesignHeight="450" d:DesignWidth="800" Background="Gainsboro"
          Title="Appointment">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="Back" Content="Назад" Width="80" Height="30" 
                HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Новая запись" FontSize="22" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,5,0,5"/>

        <Grid Grid.Row="2" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Услуга:" FontWeight="Bold" FontSize="13" VerticalAlignment="Top"/>
            <TextBlock Grid.Column="1" x:Name="Service" FontSize="13" TextWrapping="Wrap"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Мастер:" FontWeight="Bold" FontSize="13"/>
            <TextBlock Grid.Column="1" x:Name="Master" FontSize="13"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Стоимость:" FontWeight="Bold" FontSize="13"/>
            <TextBlock Grid.Column="1" x:Name="Price" FontSize="13" FontWeight="Bold"/>
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,5">


            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Дата:" Width="100" FontSize="13" FontWeight="Bold"/>
                <DatePicker x:Name="Date" Width="180" HorizontalAlignment="Left"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Время:" Width="100" FontWeight="Bold" FontSize="13" />
                <ComboBox x:Name="Time" Width="120" HorizontalAlignment="Left"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="6" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Оплата:" Width="100" FontSize="13" FontWeight="Bold"/>
                    <ComboBox x:Name="Payment" Width="180" DisplayMemberPath="Name"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Комментарий:" Width="100" FontSize="13" FontWeight="Bold" VerticalAlignment="Top"/>
                    <TextBox x:Name="Comment" Width="150" Height="40" TextWrapping="Wrap" 
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="590,-53,40,53" Grid.ColumnSpan="2">
                <Button x:Name="Confirm" Content="Записаться" Width="100" Height="38" 
                        Background="LightGreen" FontSize="13" Click="Confirm_Click" Margin="0,0,0,10"/>
                <Button x:Name="Cancel" Content="Отмена" Width="100" Height="38" 
                        FontSize="13" Click="Back_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
            