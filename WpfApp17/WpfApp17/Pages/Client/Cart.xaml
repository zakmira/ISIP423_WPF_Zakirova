<Page x:Class="WpfApp17.Pages.Client.Cart"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Gainsboro"
      Title="Cart">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button x:Name="Back" Content="Назад" Width="80" Height="30" 
                HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Ваша корзина" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20" VerticalAlignment="Top"/>

        <ListBox x:Name="CartList" Grid.Row="1" Margin="0,30,0,10" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" 
                        Margin="5,5" Padding="10" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0:F2} ₽'}" FontSize="12" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding DiscountPercent, StringFormat='Скидка: {0}%'}" FontSize="11" Foreground="Red"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                                <Button Content="-" Width="30" Height="30" Click="Decrease_Click" Tag="{Binding}"/>
                                <TextBlock Text="{Binding Quantity}" Width="40" TextAlignment="Center" FontSize="14" VerticalAlignment="Center"/>
                                <Button Content="+" Width="30" Height="30" Click="Increase_Click" Tag="{Binding}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat='Цена: {0:F2} ₽'}" 
                                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="20,0"/>

                            <Button Grid.Column="3" Content="Очистить" Width="60" Height="30" 
                                    Click="Remove_Click" Tag="{Binding}" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Background="White" BorderBrush="LightGray" BorderThickness="1" 
                CornerRadius="8" Padding="15" Margin="0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Итого к оплате:" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="С учетом всех скидок" FontSize="11" Foreground="Gray"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="TotalAmount" FontSize="22" FontWeight="Bold"/>
                    <Button x:Name="Checkout" Content="Оформить заказ" Width="150" Height="35" 
                            Margin="0,5,0,0" Background="LightGreen" FontSize="13"
                            Click="Checkout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Visibility="Collapsed" x:Name="EmptyCartPanel">
            <TextBlock Text="Корзина пуста" FontSize="18" Foreground="Gray" Margin="0,10,0,0"/>
            <Button Content="Перейти к товарам" Width="150" Height="35" Margin="0,20" 
                    Click="GoToProducts_Click" Background="LightBlue"/>
        </StackPanel>
    </Grid>
</Page>
            