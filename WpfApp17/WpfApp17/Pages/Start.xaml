<Page x:Class="WpfApp17.Pages.Start"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Gainsboro"
      Title="Start">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Запись к мастеру" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Margin="0,8">
            <TextBlock Text="Выберите мастера:" FontWeight="Bold" FontSize="14"/>
            <ComboBox x:Name="Master" DisplayMemberPath="FullName" 
                      SelectionChanged="Master_SelectionChanged" Margin="0,5,0,8"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,8">
            <TextBlock Text="Выберите услугу:" FontWeight="Bold" FontSize="14"/>
            <ComboBox x:Name="Service" DisplayMemberPath="Name" 
                      SelectionChanged="Service_SelectionChanged" Margin="0,5,0,8"/>
        </StackPanel>
        
        <StackPanel Grid.Row="3" Margin="0,8">
            <TextBlock Text="Доступные мастера:" FontWeight="Bold" FontSize="14"/>
            <ListBox x:Name="AvailableMasters" DisplayMemberPath="FullName" 
                     Height="40" Margin="0,5,0,8" SelectionChanged="AvailableMasters_SelectionChanged"/>
        </StackPanel>

        <Button x:Name="Book" Grid.Row="4" Content="Записаться" Width="150" Height="40" 
                HorizontalAlignment="Center" Margin="0,8" IsEnabled="False" 
                Click="Book_Click" Background="LightGreen" FontSize="14"/>

        <Button x:Name="Back" Grid.Row="5" Content="Назад" Width="100" Height="30" 
                HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                Click="Back_Click" Visibility="Collapsed"/>
    </Grid>
</Page>
