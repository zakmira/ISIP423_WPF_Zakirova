<Page x:Class="WpfApp1.Pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Beige"
      Title="Page3">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                       Text="Шаг 3: общая стоимость" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="ModelTextBlock" FontSize="18" Margin="0,5"/>
            <TextBlock x:Name="EngineTextBlock" FontSize="18" Margin="0,5" Text=""/>
            <TextBlock x:Name="ColorTextBlock" FontSize="18" Margin="0,5"/>
            <TextBlock x:Name="OptionTextBlock" FontSize="18" Margin="0,5"/>
            <TextBlock x:Name="TotalTextBlock" FontSize="24" FontWeight="Bold" Margin="0,20,0,0"/>
        </StackPanel>

        <Button Grid.Row="2" 
                    x:Name="NextPageButton" 
                    Content="Далее" 
                    FontSize="18" 
                    Background="LawnGreen" 
                    Foreground="Black"
                    Height="50" 
                    Width="150" 
                    Click="NextPageButton_Click"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,0"/>
    </Grid>
</Page>
