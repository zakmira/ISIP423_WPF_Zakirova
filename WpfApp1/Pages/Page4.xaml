<Page x:Class="WpfApp1.Pages.Page4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Beige"
      Title="Page4">

    <StackPanel Margin="20">

        <TextBlock 
            Text="Шаг 4: расчет кредита" 
            FontSize="24" 
            FontWeight="Bold" 
            HorizontalAlignment="Center" 
            Margin="0,0,0,5"/>

        <TextBlock 
            Text="Стоимость авто:" 
            FontSize="16" 
            Margin="0,0,0,5"/>
        <TextBlock 
            x:Name="CarPriceText" 
            FontSize="16" 
            FontWeight="SemiBold" 
            Margin="0,0,0,5"/>

        <TextBlock 
            Text="Первоначальный взнос (₽):" 
            FontSize="16" 
            Margin="0,0,0,5"/>
        <TextBox 
            x:Name="DownPaymentBox" 
            FontSize="16"
            Width="200"
            HorizontalAlignment="Left"
            Text="0" 
            Margin="0,0,0,5"/>

        <TextBlock 
            Text="Годовая ставка (%):" 
            FontSize="16" 
            Margin="0,0,0,5"/>
        <TextBox 
            x:Name="RateBox" 
            FontSize="16"
            Width="200"
            HorizontalAlignment="Left"
            Text="12" 
            Margin="0,0,0,5"/>

        <TextBlock 
            Text="Срок кредита (месяцы):" 
            FontSize="16" 
            Margin="0,0,0,5"/>
        <TextBox 
            x:Name="TermBox" 
            FontSize="16" 
            Width="200"
            HorizontalAlignment="Left"
            Text="36" 
            Margin="0,0,0,5"/>

        <Button 
            Content="Рассчитать" 
            FontSize="18" 
            Click="CalculateButton_Click" 
            Height="50" 
            Width="150"
            Background="LawnGreen" 
            Margin="500,-230,0,50"
            HorizontalAlignment="Left"/>

        <TextBlock 
            x:Name="ResultText" 
            FontSize="18" 
            FontWeight="Bold" 
            Foreground="Black" 
            TextWrapping="Wrap" 
            HorizontalAlignment="Right"
            Margin="0,-100,0,0"/>

        <Button 
        x:Name="NextPageButton" 
        Content="Далее" 
        FontSize="18" 
        Background="LawnGreen" 
        Foreground="Black"
        Height="50" 
        Width="150" 
        Click="NextPageButton_Click"
        HorizontalAlignment="Center"
        Margin="0,18,0,10"/>

    </StackPanel>

</Page>