<Page x:Class="WpfApp1.Pages.Page5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Beige"
      Title="Page5">

    <Grid>
        <StackPanel Margin="20">

            <TextBlock 
            Text="Шаг 5: оформление заявки" 
            FontSize="24" 
            FontWeight="Bold" 
            HorizontalAlignment="Center" 
            Margin="0,0,0,5"/>
            
           
            <TextBlock 
            Text="Имя:" 
            FontSize="16" 
            Margin="0,0,0,5"/>
            <TextBox 
            x:Name="NameBox" 
            FontSize="16"
            Width="200"
            HorizontalAlignment="Left"
            Text="" 
            TextChanged="NameBox_TextChanged"
            Margin="0,0,0,5"/>

            <TextBlock 
            Text="Телефон:" 
            FontSize="16" 
            Margin="0,0,0,5"/>
            <TextBox 
            x:Name="PhoneBox" 
            FontSize="16"
            Width="200"
            HorizontalAlignment="Left"
            Text="" 
            TextChanged="PhoneBox_TextChanged"
            Margin="0,0,0,5"/>

            <TextBlock 
            Text="Электронная почта:" 
            FontSize="16" 
            Margin="0,0,0,5"/>
            <TextBox 
            x:Name="MailBox" 
            FontSize="16" 
            Width="200"
            HorizontalAlignment="Left"
            Text="" 
            TextChanged="MailBox_TextChanged"
            Margin="0,0,0,5"/>

            <Button 
            x:Name="SubmitButton" 
            Content="Оформить заявку" 
            FontSize="18" 
            Background="LawnGreen" 
            Foreground="Black"
            Height="50" 
            Width="150" 
            Click="SubmitButton_Click"
            HorizontalAlignment="Center"
            Margin="0,18,0,10"/>

        </StackPanel>
    </Grid>

</Page>
