<Page x:Class="WpfApp1.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="Beige"
      Title="Page2">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Шаг 2: выбор цвета и доп. опции" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">

            <TextBlock Text="Выберите один из доступных цветов:" 
                       FontSize="20" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <RadioButton Content="Белый" 
                             GroupName="Group3" 
                             FontSize="15" 
                             Checked="ColorRadioButton_Checked"
                             Margin="5"/>
                <RadioButton Content="Черный" 
                             GroupName="Group3" 
                             FontSize="15" 
                             Checked="ColorRadioButton_Checked"
                             Margin="5"/>
                <RadioButton Content="Красный" 
                             GroupName="Group3" 
                             FontSize="15" 
                             Checked="ColorRadioButton_Checked"
                             Margin="5"/>
                <RadioButton Content="Синий" 
                             GroupName="Group3" 
                             FontSize="15" 
                             Checked="ColorRadioButton_Checked"
                             Margin="5"/>
            </StackPanel>

            <TextBlock Text="Выберите доп. опцию:" 
                       FontSize="20" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                <RadioButton Content="Мультимедиа" 
                             GroupName="Group4" 
                             FontSize="15" 
                             Checked="OptionRadioButton_Checked"
                             Margin="5"/>
                <RadioButton Content="Антикоррозия" 
                             GroupName="Group4" 
                             FontSize="15" 
                             Checked="OptionRadioButton_Checked"
                             Margin="5"/>
                <RadioButton Content="Климат-контроль" 
                             GroupName="Group4" 
                             FontSize="15" 
                             Checked="OptionRadioButton_Checked"
                             Margin="5"/>
            </StackPanel>

        </StackPanel>

        <Button Grid.Row="2" 
                x:Name="NextPageButton" 
                Content="Далее" 
                FontSize="18" 
                Background="LawnGreen" 
                Foreground="Black"
                Height="50" 
                Width="150" 
                Click="NextPageButton_Click"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"/>
    </Grid>
</Page>
