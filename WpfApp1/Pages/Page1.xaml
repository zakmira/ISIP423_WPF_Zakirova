<Page x:Class="WpfApp1.Pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="BlanchedAlmond"
      Title="Page1">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Добро пожаловать в супермаркет!"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,40"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProductList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" 
                                   Margin="10"
                                   HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <StackPanel>
                            <Image Source="{Binding ImagePath}"
                                       Width="70" Height="70"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding Name}" 
                                           FontWeight="Bold" 
                                           FontSize="14" 
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>

                            <TextBlock Text="{Binding Price, StringFormat=C, ConverterCulture=ru-RU}" 
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,5"/>

                            <Button     Content="В корзину"
                                        x:Name="AddToCart"
                                        Click="ToCart_Click"
                                        HorizontalAlignment="Center"
                                        Background="Chocolate"
                                        Margin="10"
                                        Padding="10,4"
                                        Width="130" Height="30"/>
                        </StackPanel>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2"
                x:Name="NextPageButton"
                Content="Далее"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="Chocolate"
                Margin="0,10,0,20"
                Width="130"
                Padding="20,10"
                FontSize="16" Click="NextPageButton_Click"/>

    </Grid>
</Page>