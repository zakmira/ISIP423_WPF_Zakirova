<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10">
            <TextBlock x:Name="TitleTextBlock" Margin="5" VerticalAlignment="Center"/>
        </StackPanel>
        <Frame x:Name="MainFrame" Grid.Row="1" Navigated="MainFrame_OnNavigated" NavigationUIVisibility="Hidden"/>
        <Button x:Name="BackButton" Content="Назад" Background="LawnGreen" Click="BackButton_OnClick"  Margin="694,10,10,328" Grid.Row="1"/>
        <ProgressBar x:Name="StepProgressBar"
                     Height="10" VerticalAlignment="Top"
                     Margin="0,0,0,0" Value="1"
                     Minimum="1" Maximum="5"
                     Foreground="LawnGreen"/>

        <Button x:Name="NavigateToPr10Button" 
                Content="Перейти к справочной странице" 
                Width="200" Height="40" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Click="NavigateToPr10_Click"/>
    </Grid>
</Window>
